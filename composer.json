{
    "name": "astrotomic/untracked",
    "description": "",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Tom Herrmann",
            "homepage": "https://gummibeer.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "astrotomic/php-unavatar": "^0.3",
        "geoip2/geoip2": "^3.4",
        "laravel/framework": "^13.31",
        "league/iso3166": "^4.5",
        "spatie/emoji": "^4.1.3",
        "ua-parser/uap-php": "^3.10"
    },
    "require-dev": {
        "astrotomic/phpunit-assertions": "^0.14.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpunit/phpunit": "^12.5.35",
        "spaze/phpstan-disallowed-calls": "^4.14"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "fix": "@php vendor/bin/pint",
        "fix-dirty": "@php vendor/bin/pint --dirty",
        "normalize": "echo 'composer global require ergebnis/composer-normalize'",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-baseline": "@php vendor/bin/phpstan analyse --memory-limit=2G --allow-empty-baseline --generate-baseline",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
